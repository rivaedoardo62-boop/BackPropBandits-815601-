# ─────────────────────────────────────────────────────────────────────────────
# Rental Intelligence Liguria — configurazione runtime
# Copia questo file in `.env` e compila. NON committare mai `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# === Agente 5: report LLM ====================================================
# RI_LLM_ENABLED=false  -> report deterministico da template, nessuna chiamata API
# RI_LLM_ENABLED=true   -> narrazione + giudizio con Claude
RI_LLM_ENABLED=false
ANTHROPIC_API_KEY=
RI_LLM_MODEL=claude-opus-5
# Livello di sforzo del modello: low | medium | high | xhigh | max
RI_LLM_EFFORT=high

# === Sorgenti dati ===========================================================
# Elenco separato da virgole dei connettori attivi. Vedi config/sources.yaml.
# `demo` genera un dataset sintetico realistico: serve per far girare la
# pipeline end-to-end senza alcuna sorgente esterna.
RI_SOURCES=demo

# --- Idealista (API ufficiale, richiede accreditamento) ---
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=

# --- Booking.com Demand API (richiede partnership approvata) ---
BOOKING_DEMAND_API_KEY=
BOOKING_AFFILIATE_ID=

# --- Provider STR in licenza (AirDNA / Transparent / Key Data / ...) ---
STR_PROVIDER_API_KEY=
STR_PROVIDER_BASE_URL=

# === Percorsi ================================================================
RI_DB_PATH=rental_intelligence/data/ri.sqlite
RI_OUTPUT_DIR=rental_intelligence/data/out
