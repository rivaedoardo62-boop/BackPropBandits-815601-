# Nessuna credenziale e' necessaria: l'API di filings.xbrl.org e' pubblica.
# Copiare in .env (escluso da git) e caricare con:  set -a; . ./.env; set +a
# oppure con Docker:  docker run --env-file .env ...

# Contatto opzionale aggiunto allo User-Agent (es. una casella di team). Vuoto = nessun contatto.
ESEF_CONTACT=

# Secondi di attesa tra una richiesta e l'altra. Il codice rifiuta valori < 1.0.
ESEF_REQUEST_INTERVAL=1.5

# Timeout HTTP in secondi.
ESEF_HTTP_TIMEOUT=120

# Cartelle (default: ./data e ./config nella radice del progetto; /app/data e /app/config nel container).
# ESEF_DATA_DIR=./data
# ESEF_CONFIG_DIR=./config

# Proxy e certificati aziendali, se necessari (letti direttamente da requests):
# HTTPS_PROXY=http://proxy.example:8080
# REQUESTS_CA_BUNDLE=/percorso/ca-aziendale.pem
