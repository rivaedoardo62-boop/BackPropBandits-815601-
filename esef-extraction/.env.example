# Copiare in .env e compilare. Nessuna credenziale è necessaria: l'API di
# filings.xbrl.org è pubblica. Non inserire segreti in questo file.

# User-Agent descrittivo per le richieste a filings.xbrl.org.
# Indicare un contatto (preferibilmente istituzionale) per eventuali segnalazioni del gestore.
FILINGS_API_USER_AGENT="esef-extraction-prototype/0.1 (research prototype; contact: <indirizzo-di-contatto>)"

# Ritardo minimo tra due richieste, in secondi (il codice rifiuta valori < 1).
FILINGS_API_MIN_DELAY_S=1.5

# Timeout per richiesta, in secondi.
FILINGS_API_TIMEOUT_S=60
